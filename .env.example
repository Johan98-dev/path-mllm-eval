# =============================================================================
# Plantilla de Variables de Entorno
# Copia este archivo como '.env' y completa con tus credenciales.
# =============================================================================

# Token de lectura/acceso de Hugging Face (para datasets gated como Quilt-1M, Quilt-Instruct)
HF_TOKEN="hf_your_huggingface_token_here"

# API Key de Google Gemini (si usas modelos de Gemini para auditoría o evaluación preliminar)
GEMINI_API_KEY="your_gemini_api_key_here"

# Rutas de almacenamiento temporal
DATA_CACHE_DIR="./cache"
REPORTS_DIR="./reports"
